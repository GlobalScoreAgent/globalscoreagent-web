name = "gsa-api-router"
main = "api-router-worker.js"
compatibility_date = "2024-01-01"

# Routes (ajusta zone/name si aplica)
[[routes]]
pattern = "api.globalscoreagent.com/v1/agents/search*"
zone_name = "globalscoreagent.com"

[[routes]]
pattern = "api.globalscoreagent.com/v1/agents/maturity*"
zone_name = "globalscoreagent.com"

# KV para rate limit (crear: wrangler kv namespace create RATE_LIMIT_KV)
[[kv_namespaces]]
binding = "RATE_LIMIT_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# Secret: wrangler secret put SUPABASE_ANON_KEY
